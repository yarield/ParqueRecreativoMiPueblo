# Copia este archivo como .env y completa los valores reales.

# Conexión a PostgreSQL
DATABASE_URL="postgresql://natacion_user:tu_password@localhost:5432/natacion"

# Clave para firmar los tokens de sesión (mínimo 16 caracteres).
# Genera una aleatoria con:  openssl rand -base64 48
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Puerto del backend
PORT=3000

# (Opcional) Origen permitido para CORS en producción, ej. https://natacion.tudominio.com
# Si se omite, se aceptan todos los orígenes (ok en red local / detrás de Nginx).
# CORS_ORIGIN="https://natacion.tudominio.com"

# Datos del primer administrador (solo para "npm run seed", una vez)
ADMIN_NOMBRE="Administrador"
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="cambia-esta-clave"
